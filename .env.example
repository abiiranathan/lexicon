# PostgreSQL connection string (required).
# PGCONN=postgres://user:password@localhost:5432/lexicon

# OAuth (Sign in with Google / GitHub). Leave a provider's pair unset to
# disable it. APP_BASE_URL must be the exact external origin users see,
# e.g. https://lexicon.example.com (http://localhost:8080 for local dev).
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
#GITHUB_CLIENT_ID=
#GITHUB_CLIENT_SECRET=
#APP_BASE_URL=http://localhost:8080

# Comma-separated login emails that become admins. Anyone else who signs in
# gets 403 and no session. Empty/missing = nobody is admin.
#ADMIN_EMAILS=you@example.com

# PDF upload library. In host mode this should be inside the indexed root;
# in VFS mode (--vfs) it is only staging space for in-flight uploads.
#UPLOAD_DIR=./uploads
#UPLOAD_MAX_MB=200
#UPLOAD_INDEX_TIMEOUT_S=1800

# Session lifetime and cookie hardening.
#SESSION_TTL_DAYS=30
#APP_SECURE_COOKIES=0
